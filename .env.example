# Copy this file to `.env` and adjust the values for your machine.

# PostgreSQL connection string.
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
# The `+asyncpg` suffix tells SQLAlchemy to use the async driver.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/urlshortener

# Public origin used when building the short URL that is returned to clients.
BASE_URL=http://localhost:8000

# Number of base62 characters per generated code.
SHORT_CODE_LENGTH=7

# How many times to retry generation if a random code is already taken.
MAX_GENERATION_ATTEMPTS=5

# Set to true to log every SQL statement (useful while developing).
ECHO_SQL=false

# Used only by tests. Points at a throwaway database that the suite
# creates and drops tables in.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/urlshortener_test
